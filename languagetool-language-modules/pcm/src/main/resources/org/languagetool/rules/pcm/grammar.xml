<!DOCTYPE rules []>

<rules xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" lang="pcm" xsi:noNamespaceSchemaLocation="../../../../../../../../../languagetool-core/src/main/resources/org/languagetool/rules/rules.xsd">
    <category id="SPELLING_ERRORS" name="Spelling Errors">
        <rulegroup id="DETERMINERS_MISSPELLING" name="Check sey spelling of determiners déy correct">
            <rule>
                <pattern>
                    <token>the</token>
                </pattern>
                <message>Spelling of English article "the" for Naija Pidgin na <suggestion>di</suggestion>.</message>
                <example correction="Di"><marker>The</marker> thing hook me for neck like bow tie.</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">your|yur|ur</token>
                </pattern>
                <message>Spelling of English possessive "your" for Naija Pidgin na <suggestion>yor</suggestion>.</message>
                <example correction="Yor"><marker>Your</marker> head no correct.</example>
            </rule>

            <rule>
                <pattern>
                    <token>her</token>
                </pattern>
                <message>Spelling of English possessive "her" for Naija Pidgin na <suggestion>ha</suggestion>.</message>
                <example correction="ha">Na <marker>her</marker> shop we dey go.</example>
            </rule>

            <rule>
                <pattern>
                    <token>our</token>
                </pattern>
                <message>Spelling of English possessive "our" for Naija Pidgin na <suggestion>awa</suggestion>.</message>
                <example correction="Awa"><marker>Our</marker> problem be sey light no dey.</example>
            </rule>

            <rule>
                <pattern>
                    <token>their</token>
                </pattern>
                <message>Spelling of English possessive "their" for Naija Pidgin na <suggestion>dia</suggestion>.</message>
                <example correction="dia">I dey go <marker>their</marker> domot.</example>
            </rule>

            <rule>
                <pattern>
                    <token>their</token>
                </pattern>
                <message>Spelling of English possessive "their" for Naija Pidgin na <suggestion>dia</suggestion>.</message>
                <example correction="dia">I dey go <marker>their</marker> domot.</example>
            </rule>

            <rule>
                <pattern>
                    <token>which</token>
                </pattern>
                <message>Spelling of English interrogative determiner "which" for Naija Pidgin na <suggestion>wich</suggestion>.</message>
                <example correction="Wich"><marker>Which</marker> day yu come?</example>
            </rule>

            <rule>
                <pattern>
                    <token>other</token>
                </pattern>
                <message>Spelling of English determiner of difference "other" for Naija Pidgin na <suggestion>oda</suggestion>.</message>
                <example correction="oda">Na di <marker>other</marker> thing wey I wan talk to yu about.</example>
            </rule>

            <rule>
                <pattern>
                    <token>another</token>
                </pattern>
                <message>Spelling of English determiner of difference "another" for Naija Pidgin na <suggestion>anoda</suggestion>.</message>
                <example correction="anoda">E get <marker>another</marker> thing wey I wan talk to yu about.</example>
            </rule>
        </rulegroup>

        <rulegroup id="DEMONSTRATIVE_PRONOUNS_MISSPELLING" name="Check sey spelling of demonstrative pronouns déy correct">
            <rule>
                <pattern>
                    <token>this</token>
                </pattern>
                <message>Spelling of English demonstrative pronoun "this" for Naija Pidgin na <suggestion>dis</suggestion>.</message>
                <example correction="Dis"><marker>This</marker> na di thing wey I want.</example>
            </rule>

            <rule>
                <pattern>
                    <token>that</token>
                </pattern>
                <message>Spelling of English demonstrative pronoun "that" for Naija Pidgin na <suggestion>dat</suggestion>.</message>
                <example correction="Dat"><marker>That</marker> boy sabi wetin I dey talk.</example>
            </rule>

            <rule>
                <pattern>
                    <token>these</token>
                </pattern>
                <message>Spelling of English demonstrative pronoun "these" for Naija Pidgin na <suggestion>dese</suggestion>.</message>
                <example correction="Dese"><marker>These</marker> men neva chop.</example>
            </rule>

            <rule>
                <pattern>
                    <token>those</token>
                </pattern>
                <message>Spelling of English demonstrative pronoun "those" for Naija Pidgin na <suggestion>dose</suggestion>.</message>
                <example correction="dose">E no go better for <marker>those</marker> people.</example>
            </rule>
        </rulegroup>

        <rulegroup id="INTERROGATIVE_PRONOUNS_MISSPELLING" name="Check sey spelling of interrogative pronouns déy correct">
            <rule>
                <pattern>
                    <token>which</token>
                </pattern>
                <message>Spelling of English interrogative pronoun "which" for Naija Pidgin na <suggestion>wich</suggestion>.</message>
                <example correction="Wich"><marker>Which</marker> kind wahala be dis?</example>
            </rule>

            <rule>
                <pattern>
                    <token>who</token>
                </pattern>
                <message>Spelling of English interrogative pronoun "who" for Naija Pidgin na <suggestion>hu</suggestion>.</message>
                <example correction="Hu"><marker>Who</marker> be dat?</example>
            </rule>
        </rulegroup>

        <rulegroup id="PERSONAL_PRONOUNS_MISSPELLING" name="Check sey spelling of personal pronouns déy correct">
            <rule>
                <pattern>
                    <token regexp="yes">ourselves|awasef</token>
                </pattern>
                <message>Di correct spelling of dis personal pronoun na <suggestion>awaself</suggestion>.</message>
                <example correction="awaself">Wetin we go cook for <marker>ourselves</marker> dis night?</example>
            </rule>

            <rule>
                <pattern>
                    <token>you</token>
                </pattern>
                <message>Spelling of English personal pronoun "you" for Naija Pidgin na <suggestion>yu</suggestion>.</message>
                <example correction="yu">Haw <marker>you</marker> déy?</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">yourself|yorsef</token>
                </pattern>
                <message>Di correct spelling of dis personal pronoun na <suggestion>yorself</suggestion>.</message>
                <example correction="yorself">Mek yu do am <marker>yourself</marker> o.</example>
            </rule>

            <rule>
                <pattern>
                    <token>imsef</token>
                </pattern>
                <message>Di correct spelling of dis personal pronoun na <suggestion>imself</suggestion>.</message>
                <example correction="imself">E want keep am for <marker>imsef</marker>.</example>
            </rule>

            <rule>
                <pattern>
                    <token>her</token>
                </pattern>
                <message>Spelling of English personal pronoun "her" for Naija Pidgin na <suggestion>ha</suggestion>.</message>
                <example correction="Ha"><marker>Her</marker> name na wetin?</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">herself|hasef</token>
                </pattern>
                <message>Di correct spelling of dis personal pronoun na <suggestion>haself</suggestion>.</message>
                <example correction="haself">Na ha do <marker>herself</marker> o.</example>
            </rule>

            <rule>
                <pattern>
                    <token>them</token>
                </pattern>
                <message>Spelling of English personal pronoun "them" for Naija Pidgin na <suggestion>dem</suggestion>.</message>
                <example correction="Dem"><marker>Them</marker> no sabi sey things dey hard.</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">themselves|diasef</token>
                </pattern>
                <message>Di correct spelling of dis personal pronoun na <suggestion>diaself</suggestion>.</message>
                <example correction="diaself">Na dem do am to <marker>themselves</marker>.</example>
            </rule>
        </rulegroup>

        <rulegroup id="INDEFINITE_PRONOUNS_MISSPELLING" name="Check sey spelling of indefinite pronouns déy correct">
            <rule>
                <pattern>
                    <token regexp="yes">pesin|persin</token>
                </pattern>
                <message>Di correct spelling of dis word na <suggestion>person</suggestion>.</message>
                <example correction="person">Na one <marker>pesin</marker> tell me.</example>
                <example correction="person">Hu be dat <marker>persin</marker>?</example>
            </rule>

            <rule>
                <pattern>
                    <token>anybodi</token>
                </pattern>
                <message>Di correct spelling of dis pronoun na <suggestion>anybody</suggestion>.</message>
                <example correction="anybody">I no see <marker>anybodi</marker> for house.</example>
            </rule>

            <rule>
                <pattern>
                    <token>anytin</token>
                </pattern>
                <message>Di correct spelling of dis pronoun na <suggestion>anything</suggestion>.</message>
                <example correction="anything">I no sabi <marker>anytin</marker> about am.</example>
            </rule>

            <rule>
                <pattern>
                    <token>everybodi</token>
                </pattern>
                <message>Di correct spelling of dis pronoun na <suggestion>everybody</suggestion>.</message>
                <example correction="Everybody"><marker>Everybodi</marker> don waka go.</example>
            </rule>

            <rule>
                <pattern>
                    <token>everytin</token>
                </pattern>
                <message>Di correct spelling of dis pronoun na <suggestion>everything</suggestion>.</message>
                <example correction="everything">I don pack <marker>everytin</marker> for bag.</example>
            </rule>

            <rule>
                <pattern>
                    <token>nobodi</token>
                </pattern>
                <message>Di correct spelling of dis pronoun na <suggestion>nobody</suggestion>.</message>
                <example correction="Nobody"><marker>Nobodi</marker> dey house.</example>
            </rule>

            <rule>
                <pattern>
                    <token>notin</token>
                </pattern>
                <message>Di correct spelling of dis pronoun na <suggestion>nothing</suggestion>.</message>
                <example correction="Nothing"><marker>Notin</marker> dey happen.</example>
            </rule>

            <rule>
                <pattern>
                    <token>somebodi</token>
                </pattern>
                <message>Di correct spelling of dis pronoun na <suggestion>somebody</suggestion>.</message>
                <example correction="Somebody"><marker>Somebodi</marker> knock for gate.</example>
            </rule>

            <rule>
                <pattern>
                    <token>sometin</token>
                </pattern>
                <message>Di correct spelling of dis pronoun na <suggestion>something</suggestion>.</message>
                <example correction="something">I hear <marker>sometin</marker> for backyard.</example>
            </rule>

            <rule>
                <pattern>
                    <token>somewhere</token>
                </pattern>
                <message>Di correct spelling of dis pronoun na <suggestion>somewer</suggestion>.</message>
                <example correction="somewer">I dey go <marker>somewhere</marker>.</example>
            </rule>

            <rule>
                <pattern>
                    <token>everywhere</token>
                </pattern>
                <message>Di correct spelling of dis pronoun na <suggestion>everywer</suggestion>.</message>
                <example correction="Everywer"><marker>Everywhere</marker> hot for dis country.</example>
            </rule>

            <rule>
                <pattern>
                    <token>nowhere</token>
                </pattern>
                <message>Di correct spelling of dis pronoun na <suggestion>nower</suggestion>.</message>
                <example correction="Nower"><marker>Nowhere</marker> safe for dis country o.</example>
            </rule>
        </rulegroup>

        <rulegroup id="ADVERBS_MISSPELLING" name="Check sey spelling of adverbs déy correct">
            <rule>
                <pattern>
                    <token>when</token>
                </pattern>
                <message>Spelling of English adverb "when" for Naija Pidgin na <suggestion>wen</suggestion>.</message>
                <example correction="Wen"><marker>When</marker> yu dey go house?</example>
            </rule>

            <rule>
                <pattern>
                    <token>where</token>
                </pattern>
                <message>Spelling of English adverb "where" for Naija Pidgin na <suggestion>wer</suggestion>.</message>
                <example correction="Wer"><marker>Where</marker> yu dey?</example>
            </rule>

            <rule>
                <pattern>
                    <token>why</token>
                </pattern>
                <message>Spelling of English adverb "why" for Naija Pidgin na <suggestion>wai</suggestion>.</message>
                <example correction="Wai"><marker>Why</marker> yu no wan go Lagos?</example>
            </rule>

            <rule>
                <pattern>
                    <token>how</token>
                </pattern>
                <message>Spelling of English adverb "how" for Naija Pidgin na <suggestion>haw</suggestion>.</message>
                <example correction="Haw"><marker>How</marker> far?</example>
            </rule>

            <rule>
                <pattern>
                    <token>there</token>
                </pattern>
                <message>Spelling of English adverb "there" for Naija Pidgin na <suggestion>der</suggestion>.</message>
                <example correction="der">We dey go <marker>there</marker>.</example>
            </rule>

            <rule>
                <pattern>
                    <token>never</token>
                </pattern>
                <message>Spelling of English adverb "never" for Naija Pidgin na <suggestion>neva</suggestion>.</message>
                <example correction="neva">I <marker>never</marker> go market.</example>
            </rule>

            <rule>
                <pattern>
                    <token>enuf</token>
                </pattern>
                <message>Di correct spelling of dis adverb na <suggestion>enough</suggestion>.</message>
                <example correction="enough">I no get <marker>enuf</marker> money for my trip.</example>
            </rule>

            <rule>
                <pattern>
                    <token>yer</token>
                </pattern>
                <message>Di correct spelling of dis adverb na <suggestion>here</suggestion>.</message>
                <example correction="here">Wetin una dey do for <marker>yer</marker>?</example>
            </rule>

            <rule>
                <pattern>
                    <marker>
                        <token regexp="yes">con|com|kor</token>
                    </marker>
                    <token postag_regexp="yes" postag="VB" />
                </pattern>
                <message>Di correct spelling of dis adverb na <suggestion>kon</suggestion>.</message>
                <example correction="kon">If I settle di man now, e no go <marker>con</marker> finish my work.</example>
            </rule>

            <rule>
                <pattern>
                    <token>togeda</token>
                </pattern>
                <message>Di correct spelling of dis adverb na <suggestion>together</suggestion>.</message>
                <example correction="together">We begin trek <marker>togeda</marker></example>
            </rule>
        </rulegroup>

        <rulegroup id="PREPOSITIONS_MISSPELLING" name="Check sey spelling of prepositions déy correct">
            <rule>
                <pattern>
                    <token>wit</token>
                </pattern>
                <message>Di correct spelling of dis preposition na <suggestion>with</suggestion>.</message>
                <example correction="with">Dem want chop rice <marker>wit</marker> stew.</example>
            </rule>

            <rule>
                <pattern>
                    <token>witout</token>
                </pattern>
                <message>Di correct spelling of dis preposition na <suggestion>without</suggestion>.</message>
                <example correction="without">I no fit do am <marker>witout</marker> yu.</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">thru|tru</token>
                </pattern>
                <message>Di correct spelling of dis preposition na <suggestion>through</suggestion>.</message>
                <example correction="through">Yu no sabi wetin I dey go <marker>thru</marker>.</example>
                <example correction="through">Yu no sabi wetin I dey go <marker>tru</marker>.</example>
            </rule>
        </rulegroup>

        <rulegroup id="CONJUNCTIONS_MISSPELLING" name="Check sey spelling of conjunctions déy correct">
            <rule id="SEY_SUBORDINATING_CONJUNCTION" name="Check sey spelling of subordinating conjunction &quot;sey&quot; déy correct">
                <antipattern>
                    <token regexp="yes">use</token>
                    <token regexp="yes">say|sei|se</token>
                </antipattern>

                <pattern>
                    <token postag_regexp="yes" postag="VB|JJ" />
                    <marker>
                        <token regexp="yes">say|sei|se</token>
                    </marker>
                </pattern>
                <message>Spelling of di subordinating conjunction <suggestion>sey</suggestion> no correct. E suppose be "<match no="1" /> sey".</message>
                <example correction="sey">Dem talk <marker>say</marker> wahala dey.</example>
                <example correction="sey">Yu lucky <marker>sei</marker> I no bring my book.</example>
                <example type="correct">Wetin dem dey use say sorry or take heart.</example>
            </rule>

            <rule>
                <pattern>
                    <token>whether</token>
                </pattern>
                <message>Spelling of English conjunction "whether" for Naija Pidgin na <suggestion>weda</suggestion>.</message>
                <example correction="weda">She ask me <marker>whether</marker> I go like work for am.</example>
            </rule>

            <rule>
                <pattern>
                    <token>because</token>
                </pattern>
                <message>Spelling of English conjunction "because" for Naija Pidgin na <suggestion>becos</suggestion>.</message>
                <example correction="becos">E no go come <marker>because</marker> im dey sick.</example>
            </rule>

            <rule>
                <pattern>
                    <token>bifor</token>
                </pattern>
                <message>Di correct spelling of dis word na <suggestion>before</suggestion>.</message>
                <example correction="before">Mek I no chuk mouth <marker>bifor</marker> I go collect slap.</example>
            </rule>
        </rulegroup>

        <rulegroup id="ADJECTIVES_MISSPELLING" name="Check sey spelling of adjectives déy correct">
            <rule>
                <pattern>
                    <token>plenti</token>
                </pattern>
                <message>Di correct spelling of dis adjective na <suggestion>plenty</suggestion>.</message>
                <example correction="plenty">I get <marker>plenti</marker> wahala.</example>
            </rule>
        </rulegroup>

        <rulegroup id="VERBS_MISSPELLING" name="Check sey spelling of verbs déy correct">
            <rule>
                <pattern>
                    <token>wan</token>
                </pattern>
                <message>Di correct spelling of dis verb na <suggestion>want</suggestion>.</message>
                <example correction="want">She <marker>wan</marker> chop all my money.</example>
            </rule>

            <rule>
                <antipattern>
                    <token regexp="yes">na|be</token>
                    <token>thief</token>
                </antipattern>

                <pattern>
                    <token postag_regexp="yes" postag="NN.*|VB|PRP" />
                    <marker>
                        <token regexp="yes">tiff|tiif|thief</token>
                    </marker>
                </pattern>

                <message>Di correct spelling of dis verb na <suggestion>thieve</suggestion>.</message>
                <example correction="thieve">Dem don <marker>tiff</marker> dat my fine watch o.</example>
                <example correction="thieve">Politicians <marker>tiif</marker> di whole budget.</example>
                <example correction="thieve">Wetin she <marker>thief</marker>?</example>
                <example type="correct">Na hu dem catch be thief.</example>
            </rule>

            <rule>
                <pattern>
                    <token>laff</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>laugh</suggestion>.</message>
                <example correction="laugh">I don <marker>laff</marker> tire.</example>
            </rule>

            <rule>
                <pattern>
                    <token>breet</token>
                </pattern>
                <message>Di correct spelling of dis verb na <suggestion>breathe</suggestion>.</message>
                <example correction="breathe">Hu dey <marker>breet</marker>?</example>
            </rule>

            <rule>
                <pattern>
                    <token>tok</token>
                </pattern>
                <message>Di correct spelling of dis verb na <suggestion>talk</suggestion>.</message>
                <example correction="talk">Mek we <marker>tok</marker> later.</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">comot|commot|kommot|kormot</token>
                </pattern>
                <message>Di correct spelling of dis verb na <suggestion>komot</suggestion>.</message>
                <example correction="komot">She neva <marker>comot</marker> house.</example>
                <example correction="komot">I go soon <marker>commot</marker>.</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">chook|shook</token>
                </pattern>
                <message>Di correct spelling of dis verb na <suggestion>chuk</suggestion>.</message>
                <example correction="chuk">No <marker>chook</marker> mouth for my matter.</example>
            </rule>

            <rule>
                <pattern>
                    <token>taya</token>
                </pattern>
                <message>Di correct spelling of dis verb na <suggestion>tire</suggestion>.</message>
                <example correction="tire">We don <marker>taya</marker> for all dis nonsense.</example>
            </rule>

            <rule>
                <pattern>
                    <token>tink</token>
                </pattern>
                <message>Di correct spelling of dis verb na <suggestion>think</suggestion>.</message>
                <example correction="think">I <marker>tink</marker> sey na joke o.</example>
            </rule>

            <rule>
                <pattern>
                    <token postag_regexp="yes" postag="PRP|NN.*"/>
                    <token min="0" regexp="yes">dey|don|bin</token>
                    <marker>
                        <token regexp="yes">waka</token>
                    </marker>
                </pattern>

                <message>Di correct spelling of dis verb na <suggestion>waká</suggestion>.</message>
                <example correction="waká">As I dey <marker>waka</marker> go exam hall, I see Femi for road.</example>
            </rule>

            <rule>
                <pattern>
                    <token>bath</token>
                </pattern>
                <message>Di correct spelling of dis word na <suggestion>baff</suggestion>.</message>
                <example correction="baff">I go <marker>bath</marker> with hot water.</example>
            </rule>
        </rulegroup>

        <rulegroup id="NOUNS_MISSPELLING" name="Check sey spelling of adjectives déy correct">
            <rule>
                <pattern>
                    <token>bodi</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>body</suggestion>.</message>
                <example correction="body">My <marker>bodi</marker> dey pain me.</example>
            </rule>

            <rule>
                <pattern>
                    <token>moni</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>money</suggestion>.</message>
                <example correction="Money"><marker>Moni</marker> no be problem.</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">olopka|olopa</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>olokpa</suggestion>.</message>
                <example correction="olokpa">I late becos <marker>olopa</marker> stop me for road.</example>
                <example correction="olokpa">I dey fear <marker>olopka</marker> pass armed robber!</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">tori|stori</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>story</suggestion>.</message>
                <example correction="story">E get one <marker>tori</marker> wey I want tell yu.</example>
                <example correction="story">Oya na, yarn me di <marker>stori</marker>.</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">pesins|persons|persins|pipu|pipo</token>
                </pattern>
                <message>Mek yu use di noun <suggestion>people</suggestion>.</message>
                <example correction="people">Na good <marker>pesins</marker> dem be.</example>
                <example correction="people">Many <marker>persons</marker> waka pass yer.</example>
                <example correction="people">All dose <marker>persins</marker> no sabi road.</example>
            </rule>

            <rule>
                <pattern>
                    <token>tin</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>thing</suggestion>.</message>
                <example correction="thing">Di <marker>tin</marker> enter my body.</example>
            </rule>

            <rule>
                <pattern>
                    <token>tins</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>things</suggestion>.</message>
                <example correction="things">Di <marker>tins</marker> wey I don see no be small.</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">ynash|nyansh</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>nyash</suggestion>.</message>
                <example correction="nyash">Wai yu dey look my <marker>ynash</marker> like dat?</example>
                <example correction="nyash">Una get big <marker>nyansh</marker> o.</example>
                <example correction="Nyash"><marker>Ynash</marker> na my mumu button.</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">blokus|blokkus|blocos|brokkus</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>blokos</suggestion>.</message>
                <example correction="blokos">Wai yu dey look my <marker>blokus</marker> like dat?</example>
                <example correction="blokos">Wai yu dey look my <marker>blokkus</marker> like dat?</example>
                <example correction="blokos">Wai yu dey look my <marker>blocos</marker> like dat?</example>
                <example correction="blokos">Wai yu dey look my <marker>brokkus</marker> like dat?</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">dommot|dormot</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>domot</suggestion>.</message>
                <example correction="domot">We dey go awa <marker>dommot</marker>.</example>
            </rule>

            <rule>
                <pattern>
                    <token>kain</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>kind</suggestion>.</message>
                <example correction="kind">Wich <marker>kain</marker> job yu dey find?</example>
            </rule>

            <rule>
                <pattern>
                    <token regexp="yes">poto-poto|potopoto|kpotokpoto</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>kpoto-kpoto</suggestion>.</message>
                <example correction="kpoto-kpoto">I no like <marker>poto-poto</marker>.</example>
            </rule>

            <rule>
                <pattern>
                    <token>moto</token>
                </pattern>
                <message>Di correct spelling of dis noun na <suggestion>motor</suggestion>.</message>
                <example correction="motor">I neva buy new <marker>moto</marker>.</example>
            </rule>
        </rulegroup>

        <rulegroup id="NAIJA_PIDGIN_MISSPELLING" name="Check sey spelling of &quot;Naija Pidgin&quot; déy correct">
            <rule>
                <pattern>
                    <token regexp="yes">Nigerian|Nigeria</token>
                    <token>Pidgin</token>
                </pattern>

                <message>\1 \2 na <suggestion>Naija Pidgin</suggestion> for Naija Pidgin.</message>
                <example correction="Naija Pidgin"><marker>Nigerian Pidgin</marker> grammar déy interesting.</example>
            </rule>

            <rule>
                <pattern>
                    <token>Nigerian</token>
                    <token>Pidgin</token>
                    <token>English</token>
                </pattern>

                <message><suggestion>Naija Pidgin</suggestion> no be English.</message>
                <example correction="Naija Pidgin">Yu sabi speak <marker>Nigerian Pidgin English</marker>?</example>
            </rule>

            <rule>
                <pattern>
                    <marker>
                        <token>Naija</token>
                    </marker>
                    <token regexp="yes">word|phrase|idiom</token>
                </pattern>

                <message>Use <suggestion>Naija Pidgin</suggestion>.</message>
                <example correction="Naija Pidgin">Na di definition of di <marker>Naija</marker> word "wahala".</example>
            </rule>
        </rulegroup>
    </category>

    <category id="GRAMMAR" name="Grammar">
        <rule id="NO_INDEFINITE_ARTICLES" name="Check sey text no get English indefinite articles for inside">
            <antipattern>
                <token>a</token>
                <token>regular</token>
            </antipattern>

            <pattern>
               <marker>
                   <token regexp="yes">a|an</token>
               </marker>
               <token postag_regexp="yes" postag="NN|JJ" />
            </pattern>
            <message>Naija Pidgin no get indefinite article.</message>
            <example correction="">I wan buy <marker>a</marker> book.</example>
            <example correction="">I don chop <marker>an</marker> apple.</example>
            <example type="correct">I dey chop beans on a regular.</example>
        </rule>

        <rulegroup id="MEK_SUBORDINATING_CONJUNCTION_AND_SUBJUNCTIVE_MARKER" name="Check sey spelling of subordinating conjunction &quot;mek&quot;/subjunctive marker déy correct">
            <rule>
                <antipattern>
                    <token regexp="yes">go|want|try</token>
                    <token>make</token>
                    <token postag_regexp="yes" postag="PRP|NN.*"/>
                </antipattern>

                <antipattern>
                    <token>na</token>
                    <token postag_regexp="yes" postag="PRP|NN.*"/>
                    <token>make</token>
                    <token postag_regexp="yes" postag="PRP|NN.*"/>
                </antipattern>

                <antipattern>
                    <token postag="SENT_START"/>
                    <token postag_regexp="yes" postag="PRP|NN.*"/>
                    <token>make</token>
                </antipattern>

                <antipattern>
                    <token regexp="yes">to|dey|fit</token>
                    <token>make</token>
                </antipattern>

                <antipattern>
                    <token>make</token>
                    <token regexp="yes">am|mouth|brain|sense</token>
                </antipattern>

                <pattern>
                    <marker>
                        <token regexp="yes">make|meik</token>
                    </marker>
                    <token postag_regexp="yes" postag="PRP|NN.*"/>
                </pattern>

                <message>Di correct spelling of di subjunctive marker na <suggestion>mek</suggestion></message>

                <example correction="mek">E dey important sey <marker>make</marker> yu sabi wetin contract talk before yu sign am.</example>
                <example type="correct">Dem want mek una komot.</example>
                <example type="correct">Dem want make una komot.</example>
                <example type="correct">Yu go make person cry.</example>
                <example correction="mek">Yu gó <marker>make</marker> we no for see yu.</example>
                <example correction="mek">E put on radio <marker>make</marker> e hear news.</example>
                <example type="correct">Na condition make crayfish bend.</example>
                <example type="correct">Di intent fit be to make request.</example>
                <example type="correct">Na im bier-bier make am look mature.</example>
                <example correction="Mek"><marker>Make</marker> person no touch my food o.</example>
                <example type="correct">Make am for me abeg.</example>
                <example type="correct">I dey try make pasta.</example>
                <example type="correct">He dey make breakfast.</example>
                <example type="correct">I fit make chow for una.</example>
                <example type="correct">Mariam make business decision.</example>
                <example type="correct">Dat guy too dey make mouth.</example>
                <example correction="mek">Na to tell person sey <marker>make</marker> dem komot money for dia market wey yu go like buy.</example>
                <example type="correct">E no make sense.</example>
            </rule>
        </rulegroup>
    </category>

    <category id="TONES" name="Tones">
        <rulegroup id="MARKED_LOW_TONE" name="Check sey tone words no dey use grave accent">
            <rule>
                <pattern>
                    <token>dèy</token>
                </pattern>
                <message>No mark low tone with grave accent. Mek yu use <suggestion>dey</suggestion>.</message>
                <example correction="dey">I <marker>dèy</marker> find money.</example>
            </rule>

            <rule>
                <pattern>
                    <token>gò</token>
                </pattern>
                <message>No mark low tone with grave accent. Mek yu use <suggestion>go</suggestion>.</message>
                <example correction="go">I <marker>gò</marker> soon reach house.</example>
            </rule>
        </rulegroup>

        <rulegroup id="UNMARKED_HIGH_TONE" name="Check sey tone words dey use acute accent">
            <rule>
                <pattern>
                    <token>to</token>
                    <marker>
                        <token>go</token>
                    </marker>
                </pattern>
                <message>Dey mark high tone with acute accent. Mek yu use <suggestion>gó</suggestion>.</message>
                <example correction="gó">She decide to <marker>go</marker> see doctor.</example>
            </rule>

            <rule>
                <pattern>
                    <marker>
                        <token>go</token>
                    </marker>
                    <token postag_regexp="yes" postag="NN.*">
                        <exception postag="VB|JJ|RB" postag_regexp="yes"/>
                    </token>
                </pattern>

                <message>Dey mark high tone with acute accent. Mek yu use <suggestion>gó</suggestion>.</message>

                <example correction="gó">My pikin don <marker>go</marker> Paris.</example>
                <example correction="gó">Abeg, no <marker>go</marker> China o.</example>
                <example type="correct">I go market di product later.</example>
                <example type="correct">Papa no go quick come back today.</example>
            </rule>

            <rule>
                <pattern>
                    <marker>
                        <token>dey</token>
                    </marker>
                    <token postag="JJ|JJR|NN.*" postag_regexp="yes">
                        <exception postag="VB|RB" postag_regexp="yes"/>
                    </token>
                </pattern>

                <message>Dey mark high tone with acute accent. Mek yu use <suggestion>déy</suggestion>.</message>

                <example correction="déy">My pikin <marker>dey</marker> sad today.</example>
                <example correction="déy">Una no <marker>dey</marker> London?</example>
                <example type="correct">I dey book hotel for two of una.</example>
                <example type="correct">Monkey no dey born goat</example>
                <example type="correct">Awa plan no dey ever work.</example>
            </rule>
        </rulegroup>
    </category>
</rules>
